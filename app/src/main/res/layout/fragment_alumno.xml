<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_page">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:gravity="center_horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="#7A2D1E1A">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Mi Código QR"
                        android:textColor="#E9C88C"
                        android:textStyle="bold"
                        android:textSize="34sp"
                        android:gravity="center"
                        android:layout_marginBottom="14dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Matrícula"
                        android:textColor="#E9C88C"
                        android:textSize="18sp" />

                    <EditText
                        android:id="@+id/etMatriculaAlumno"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input"
                        android:hint="Ingresa matrícula"
                        android:padding="14dp"
                        android:textColor="#F6E7CF"
                        android:textColorHint="#C7A778"
                        android:inputType="text" />

                    <Button
                        android:id="@+id/btnGenerarQrAlumno"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Generar QR"
                        android:textStyle="bold"
                        android:textColor="#FFF3E0"
                        android:background="@drawable/bg_button_brown"
                        android:backgroundTint="@null"
                        app:backgroundTint="@null"
                        style="@style/Widget.Material3.Button"
                        android:layout_marginTop="14dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="18dp"
                        android:background="#6BC49C66" />

                    <TextView
                        android:id="@+id/tvNombreAlumno"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:layout_marginTop="16dp"
                        android:textColor="#F1D7A2"
                        android:textStyle="bold"
                        android:textSize="28sp" />

                    <TextView
                        android:id="@+id/tvCarreraGrupoAlumno"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:layout_marginTop="4dp"
                        android:textColor="#E7C98F"
                        android:textSize="20sp" />

                    <ImageView
                        android:id="@+id/ivQrAlumno"
                        android:layout_width="320dp"
                        android:layout_height="320dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="8dp"
                        android:padding="10dp"
                        android:visibility="gone"
                        android:contentDescription="QR del alumno" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

</FrameLayout>
